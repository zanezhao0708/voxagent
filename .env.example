# VoxAgent configuration (copy to .env and tweak)
# Everything works offline by default; no API keys required.

# --- Speech-to-Text ---
VOXAGENT_STT_ENGINE=whisper          # whisper
WHISPER_MODEL=small                  # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto                  # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto            # auto | int8 | float16

# --- Text-to-Speech ---
VOXAGENT_TTS_ENGINE=edge             # edge (zero-setup) | cosyvoice | none
TTS_VOICE=zh-CN-XiaoxiaoNeural       # edge-tts voice, e.g. en-US-AriaNeural
TTS_RATE=+0%
# CosyVoice engine (requires a local CosyVoice API server)
COSYVOICE_BASE_URL=http://127.0.0.1:9880

# --- Conversation ---
VOXAGENT_LANGUAGE=auto               # auto | zh | en | ...

# --- Recorder ---
VOXAGENT_SAMPLE_RATE=16000
VOXAGENT_SILENCE_MS=1200             # auto-stop after this much silence
VOXAGENT_SILENCE_THRESHOLD=0.01      # RMS threshold considered "silence"
VOXAGENT_MAX_RECORDING_S=60
